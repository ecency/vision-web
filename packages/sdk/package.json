{
  "name": "@ecency/sdk",
  "private": false,
  "version": "2.6.0",
  "description": "Ecency SDK",
  "repository": {
    "type": "git",
    "url": "https://github.com/ecency/vision-web.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://ecency.com",
  "bugs": {
    "url": "https://github.com/ecency/vision-web/issues"
  },
  "type": "module",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "main": "dist/node/index.cjs",
  "module": "dist/node/index.mjs",
  "types": "dist/browser/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/browser/index.d.ts",
      "browser": "./dist/browser/index.js",
      "import": "./dist/node/index.mjs",
      "require": "./dist/node/index.cjs",
      "default": "./dist/node/index.mjs"
    },
    "./hive": {
      "types": "./dist/browser/hive.d.ts",
      "browser": "./dist/browser/hive.js",
      "import": "./dist/node/hive.mjs",
      "require": "./dist/node/hive.cjs",
      "default": "./dist/node/hive.mjs"
    },
    "./wallets": {
      "types": "./dist/browser/wallets.d.ts",
      "browser": "./dist/browser/wallets.js",
      "import": "./dist/node/wallets.mjs",
      "require": "./dist/node/wallets.cjs",
      "default": "./dist/node/wallets.mjs"
    }
  },
  "browser": {
    "node-fetch": false,
    "undici": false
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@solana/web3.js": "^1",
    "@tanstack/react-query": ">=5",
    "@wallet-standard/app": "^1",
    "hivesigner": "^4.0.0",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "@tanstack/react-query": {
      "optional": true
    },
    "hivesigner": {
      "optional": false
    },
    "@solana/web3.js": {
      "optional": true
    },
    "@wallet-standard/app": {
      "optional": true
    }
  },
  "devDependencies": {
    "@solana/web3.js": "^1.98.0",
    "@types/node": "^22.13.8",
    "@vitest/coverage-v8": "^4.1.11",
    "@wallet-standard/app": "^1.1.0",
    "bip39": "^3.1.0",
    "eslint": "^9.21.0",
    "prettier": "^3.5.2",
    "tsup": "^8",
    "typescript": "^5.6",
    "typescript-eslint": "^8.18.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@noble/ciphers": "^2.1.1",
    "@noble/curves": "^2.0.1",
    "@noble/hashes": "^2.0.1",
    "@scure/base": "^1.2.4",
    "@scure/bip32": "^1.6.2",
    "@scure/bip39": "^1.5.0",
    "bs58": "6.0.0",
    "lru-cache": "^11.0.2",
    "remeda": "^2.30.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
